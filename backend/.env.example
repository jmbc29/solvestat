# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=solvestat

# Firebase Admin service account.
# Option A (recommended for Railway): paste the whole service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# Option B (local dev): path to the downloaded JSON file instead of the inline value above.
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
